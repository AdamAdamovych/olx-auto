{
  "name": "@adamadamovych/olx_auto",
  "version": "3.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamadamovych/olx-auto.git"
  },
  "publishConfig": {
    "@adamadamovych:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc --project tsconfig.prod.json && copy-files-from-to",
    "dev": "cd src/app && ts-node index.ts",
    "start": "node index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "copy-files-from-to": "^3.9.1",
    "decompress": "^4.2.1",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0",
    "nodejs-file-downloader": "^4.12.1",
    "selenium-webdriver": "^4.27.0",
    "webdriver-manager": "^12.1.9"
  },
  "devDependencies": {
    "@types/decompress": "^4.2.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node-fetch": "^2.6.10",
    "@types/selenium-webdriver": "^4.1.26",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "copyFiles": [
    {
      "from": "./package.json",
      "to": {
        "default": "./dist/package.json"
      }
    },
    {
      "from": "./package-lock.json",
      "to": {
        "default": "./dist/package-lock.json"
      }
    },
    {
      "from": "./.npmrc",
      "to": {
        "default": "./dist/.npmrc"
      }
    }
  ],
  "copyFilesSettings": {
    "whenFileExists": "overwrite"
  }
}
